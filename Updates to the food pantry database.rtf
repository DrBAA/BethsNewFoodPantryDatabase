-- Trigger: Prevents inserting a row if city_or_town or street_name contains any numbers.\par
-- Purpose: Ensures address fields remain valid text-only names (e.g., "London", "Valley Road").\par
-- Example: Input "Lon9don" or "Road 12" will cause the insert to fail.\par
\par
DELIMITER $$\par
\par
CREATE TRIGGER members_address_no_numbers_insert\par
BEFORE INSERT ON members_address\par
FOR EACH ROW\par
BEGIN\par
    IF NEW.city_or_town REGEXP '[0-9]' THEN\par
        SIGNAL SQLSTATE '45000'\par
            SET MESSAGE_TEXT = 'city_or_town cannot contain numbers';\par
    END IF;\par
\par
    IF NEW.street_name REGEXP '[0-9]' THEN\par
        SIGNAL SQLSTATE '45000'\par
            SET MESSAGE_TEXT = 'street_name cannot contain numbers';\par
    END IF;\par
END $$\par
\par
DELIMITER ;\par
\par
