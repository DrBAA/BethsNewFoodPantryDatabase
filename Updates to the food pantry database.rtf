\b 05/9/2026 \par
\b0 Added below stored function to convert strings to title case and also triggers to call the stored function\par
\b A stored function (to_title_case)\b0\par
This function converts any string into Title Case, ensuring the first letter of each word is uppercase and the remaining letters are lowercase.\par
-- Stored Function - Converts a string so each space-separated word is in Title Case (John Smith)\par
-- Takes the input string (e.g. "john smith").\par
-- Finds the next space to isolate one word at a time.\par
-- For each word:\par
-- Makes the first letter uppercase.\par
-- Makes the rest of the letters lowercase.\par
-- Adds the cleaned word to the output.\par
-- Adds a space between words while there\f1\rquote\f0 s still more text to process.\par
-- When there\f1\rquote\f0 s no text left, returns the rebuilt string.\par
-- So:\par
-- "john smith" \f3\u8594?\f1  \f0 John Smith\par
-- "mArY aNNe joNES" \f3\u8594?\f1  \f0 Mary Anne Jones\par
\par
DELIMITER $$\par
CREATE FUNCTION \b to_title_case(\b0 str VARCHAR(255))\par
RETURNS VARCHAR(255)\par
DETERMINISTIC\par
BEGIN\par
    DECLARE output VARCHAR(255) DEFAULT '';\par
    DECLARE space_pos INT;\par
    DECLARE word VARCHAR(255);\par
\par
    WHILE str IS NOT NULL AND str <> '' DO\par
        SET space_pos = INSTR(str, ' ');\par
\par
        IF space_pos = 0 THEN\par
            SET word = str;\par
            SET str = '';\par
        ELSE\par
            SET word = SUBSTRING(str, 1, space_pos - 1);\par
            SET str = SUBSTRING(str, space_pos + 1);\par
        END IF;\par
\par
        SET output = CONCAT(\par
            output,\par
            UPPER(LEFT(word, 1)),\par
            LOWER(SUBSTRING(word, 2))\par
        );\par
\par
        IF str <> '' THEN\par
            SET output = CONCAT(output, ' ');\par
        END IF;\par
    END WHILE;\par
\par
    RETURN output;\par
END $$\par
\par
DELIMITER ;\par
