\pard\sl240\slmult1 DELIMITER $$\par
\par
CREATE PROCEDURE SP_create_address(\par
    IN p_house_number_or_name VARCHAR(255),\par
    IN p_street_name  VARCHAR(255),\par
    IN p_city_or_town VARCHAR(255),\par
    IN p_post_code    VARCHAR(255),\par
    IN p_country      VARCHAR(255),\par
    \par
    OUT o_address_id  VARCHAR(10),\par
    OUT o_house_number_or_name VARCHAR(15),\par
    OUT o_street_name  VARCHAR(50),\par
    OUT o_city_or_town VARCHAR(50),\par
    OUT o_post_code    VARCHAR(10),\par
    OUT o_country      VARCHAR(2),\par
    OUT o_sqlstate VARCHAR(20) -- returns SQLSTATE/ MySql error codes\par
)\par
\par
BEGIN\par
\tab -- Declare variables\par
    DECLARE v_next_id VARCHAR(10);\par
    DECLARE v_max_num INT DEFAULT NULL;\par
    DECLARE v_attempts INT DEFAULT 0;\par
    DECLARE v_done INT DEFAULT 0;\par
\par
    -- NEW: Set lock wait timeout to 5 seconds\par
    SET innodb_lock_wait_timeout = 5;\par
\par
    -- NEW: Retry loop (max 3 attempts)\par
    WHILE v_done = 0 AND v_attempts < 3 DO\par
        SET v_attempts = v_attempts + 1;\par
\par
        BEGIN        \par
\tab\tab\tab -- NEW: Duplicate key handler (MySQL error 1062)\par
            DECLARE EXIT HANDLER FOR 1062\par
\tab\tab\tab BEGIN\par
\tab\tab\tab\tab ROLLBACK;\par
\par
\tab\tab\tab\tab -- Fetch the existing address_id based on the unique constraint\par
\tab\tab\tab\tab SELECT address_id\par
\tab\tab\tab\tab INTO o_address_id\par
\tab\tab\tab\tab FROM members_address\par
\tab\tab\tab\tab WHERE house_number_or_name = p_house_number_or_name\par
\tab\tab\tab\tab   AND post_code = p_post_code\par
\tab\tab\tab\tab LIMIT 1;\par
\par
\tab\tab\tab\tab -- Return the input values (they match the existing row)\par
\tab\tab\tab\tab SET o_house_number_or_name = p_house_number_or_name;\par
\tab\tab\tab\tab SET o_street_name = p_street_name;\par
\tab\tab\tab\tab SET o_city_or_town = p_city_or_town;\par
\tab\tab\tab\tab SET o_post_code = p_post_code;\par
\tab\tab\tab\tab SET o_country = p_country;\par
\par
\tab\tab\tab\tab SET o_sqlstate = '1062'; -- duplicate address\par
\tab\tab\tab\tab SET v_done = 1;\par
\tab\tab\tab END;\par
        \par
\tab\tab\tab -- Handle NOT NULL constraint violation (1048)\par
\tab\tab\tab DECLARE EXIT HANDLER FOR 1048\par
\tab\tab\tab BEGIN\par
\tab\tab\tab\tab ROLLBACK;\par
\tab\tab\tab\tab SET o_sqlstate = '1048';   -- NOT NULL violation\par
\tab\tab\tab\tab SET v_done = 1;            -- stop retrying\par
\tab\tab\tab END;\par
        \par
\tab\tab\tab -- Handler for 1406 (Data too long)\par
\tab\tab\tab DECLARE EXIT HANDLER FOR 1406\par
\tab\tab\tab BEGIN\par
\tab\tab\tab\tab ROLLBACK;\par
\tab\tab\tab\tab SET o_sqlstate = '1406';   -- data too long\par
\tab\tab\tab\tab SET v_done = 1;            -- stop retrying\par
\tab\tab\tab END;\par
            \par
            -- CHECK constraint violation\par
\tab\tab\tab DECLARE EXIT HANDLER FOR 3819\par
            handler_3819: BEGIN\par
\tab\tab\tab\tab ROLLBACK;\par
                \par
\tab\tab\tab\tab -- Count how many validation rules fail\par
\tab\tab\tab\tab SET @error_count = 0;\par
\par
\tab\tab\tab\tab IF p_house_number_or_name IS NULL OR p_house_number_or_name = '' THEN\par
\tab\tab\tab\tab\tab SET @error_count = @error_count + 1;\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab IF p_street_name IS NULL OR p_street_name = '' THEN\par
\tab\tab\tab\tab\tab SET @error_count = @error_count + 1;\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab IF p_city_or_town IS NULL OR p_city_or_town = '' THEN\par
\tab\tab\tab\tab\tab SET @error_count = @error_count + 1;\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab IF p_post_code IS NULL OR p_post_code = '' THEN\par
\tab\tab\tab\tab\tab SET @error_count = @error_count + 1;\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab IF p_country IS NULL OR p_country = '' THEN\par
\tab\tab\tab\tab\tab SET @error_count = @error_count + 1;\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab IF p_country <> 'UK' THEN\par
\tab\tab\tab\tab\tab SET @error_count = @error_count + 1;\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab -- If more than one validation fails, return combined error\par
\tab\tab\tab\tab IF @error_count > 1 THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'MULTI';\par
\tab\tab\tab\tab\tab SET v_done = 1;\par
                    LEAVE handler_3819;   -- \f2\u11088? THIS STOPS THE SINGLE-FIELD CHECKS \u11088?\par
\tab\tab\tab\tab END IF;                \par
\par
\tab\tab\tab\tab -- Single-field checks\par
\tab\tab\tab\tab IF p_house_number_or_name IS NULL OR p_house_number_or_name = '' THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'HOUSE_EMPTY';\par
\par
\tab\tab\tab\tab ELSEIF p_street_name IS NULL OR p_street_name = '' THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'STREET_EMPTY';\par
\par
\tab\tab\tab\tab ELSEIF p_city_or_town IS NULL OR p_city_or_town = '' THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'CITY_EMPTY';\par
\par
\tab\tab\tab\tab ELSEIF p_post_code IS NULL OR p_post_code = '' THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'POSTCODE_EMPTY';\par
\par
\tab\tab\tab\tab ELSEIF p_country IS NULL OR p_country = '' THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'COUNTRY_EMPTY';\par
\par
\tab\tab\tab\tab ELSEIF p_country <> 'UK' THEN\par
\tab\tab\tab\tab\tab SET o_sqlstate = 'COUNTRY_INVALID';\par
\par
\tab\tab\tab\tab ELSE\par
\tab\tab\tab\tab\tab SET o_sqlstate = '3819';\par
\tab\tab\tab\tab END IF;\par
\par
\tab\tab\tab\tab SET v_done = 1;\par
\tab\tab\tab END;\par
       \par
            -- Deadlock handler (SQLSTATE 40001)\par
            DECLARE EXIT HANDLER FOR SQLSTATE '40001'\par
            BEGIN\par
                ROLLBACK;\par
                -- Retry by continuing the loop\par
            END;\par
\par
            -- Generic error handler\par
            DECLARE EXIT HANDLER FOR SQLEXCEPTION\par
            BEGIN\par
                ROLLBACK;\par
                SET o_address_id = NULL;\par
                SET o_house_number_or_name = NULL;\par
                SET o_street_name = NULL;\par
                SET o_city_or_town = NULL;\par
                SET o_post_code = NULL;\par
                SET o_country = NULL;\par
                SET o_sqlstate = 'HY000'; -- other SQL error\par
                SET v_done = 1; -- Stop retrying\par
            END;\par
\par
            START TRANSACTION;\par
\par
            -- Row-level lock on the highest ID row (safe under concurrency)\par
            SELECT CAST(SUBSTRING(address_id, 2) AS UNSIGNED)\par
            INTO v_max_num\par
            FROM members_address\par
            ORDER BY CAST(SUBSTRING(address_id, 2) AS UNSIGNED) DESC\par
            LIMIT 1\par
            FOR UPDATE;\par
\par
            -- Generate next ID using prefix A\par
            IF v_max_num IS NULL THEN\par
                SET v_next_id = 'A0';\par
            ELSE\par
                SET v_next_id = CONCAT('A', v_max_num + 1);\par
            END IF;\par
\par
            -- Insert new address\par
            INSERT INTO members_address (\par
                address_id,\par
                house_number_or_name,\par
                street_name,\par
                city_or_town,\par
                post_code,\par
                country\par
            )\par
            VALUES (\par
                v_next_id,\par
                p_house_number_or_name,\par
                p_street_name,\par
                p_city_or_town,\par
                p_post_code,\par
                p_country\par
            );\par
\par
            -- Return full inserted row\par
            SET o_address_id   = v_next_id;\par
            SET o_house_number_or_name = p_house_number_or_name;\par
            SET o_street_name  = p_street_name;\par
            SET o_city_or_town = p_city_or_town;\par
            SET o_post_code    = p_post_code;\par
            SET o_country      = p_country;\par
\par
            COMMIT;\par
            \par
            SET o_sqlstate = '00000'; -- success\par
\par
            SET v_done = 1; -- Success, exit loop\par
        END;\par
    END WHILE;\par
\par
    -- If all retries failed\par
    IF v_done = 0 THEN\par
        SIGNAL SQLSTATE '45000'\par
            SET MESSAGE_TEXT = 'sp_create_address failed after 3 retry attempts.';\par
    END IF;\par
\par
END$$\par
\par
DELIMITER ;\par

